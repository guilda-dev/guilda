# ==========================
# OS Specific (Windows / macOS)
# ==========================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ==========================
# MATLAB Generic
# ==========================
# Autosave files
*.asv

# Project files (often contain user-specific settings)
*.prj

# Compiled MEX files (binary)
*.mex*
*.mexw64
*.mexmaci64
*.mexa64

# Simulink cache & code generation (if applicable)
*.slxc
slprj/
sfprj/

# ==========================
# MATLAB Drive Specific
# ==========================
# MATLAB Drive tag file (generated in root and subfolders)
.MATLABDriveTag

# MATLAB Drive temporary files
*.mw

# ==========================
# GUILDA Project Specific
# ==========================
# Ignore all files under the user directory
@GUILDA/user/*

# If you want to track the folder structure but ignore content,
# uncomment the following line (requires a .gitkeep file inside)
# !@GUILDA/user/.gitkeep
