{
    "version": 1,
    "Method":{
        "Value": "AC OPF",
        "Type": "select",
        "options":[
            "ELD",
            "DC OPF",
            "AC OPF"
        ],
        "Description": "Formulation: 'ELD' (economic load dispatch, branches ignored), 'DC OPF' (DC approximation) or 'AC OPF' (AC power flow equations)"
    },
    "Solver":{
        "Value": "auto",
        "Type": "select",
        "options":[
            "auto",
            "linprog",
            "quadprog",
            "fmincon"
        ],
        "Description": "Optimization solver ('auto': the solver that 'solve' chooses for the problem)"
    },
    "LinprogAlgorithm":{
        "Value": "dual-simplex-highs",
        "Type": "select",
        "options":[
            "interior-point-legacy",
            "interior-point",
            "dual-simplex-highs"
        ],
        "Description": "'Algorithm' option @linprog"
    },
    "QuadprogAlgorithm":{
        "Value": "interior-point-convex",
        "Type": "select",
        "options":[
            "active-set",
            "trust-region-reflective",
            "interior-point-convex"
        ],
        "Description": "'Algorithm' option @quadprog"
    },
    "FminconAlgorithm":{
        "Value": "interior-point",
        "Type": "select",
        "options":[
            "active-set",
            "sqp-codegen",
            "sqp",
            "trust-region-reflective",
            "interior-point"
        ],
        "Description": "'Algorithm' option @fmincon"
    },
    "Verbose":{
        "Value": false,
        "Type": "logical",
        "Description": "Print the progress of the solver (Display 'iter'; false: 'none')"
    },
    "MaxIteration":{
        "Value": NaN,
        "Type": "double",
        "Valid": "isnan(v) || v > 0 && mod(v,1) == 0",
        "Description": "'MaxIterations' option of the solver (NaN: the default of the solver)"
    },
    "Tolerance":{
        "Value": NaN,
        "Type": "double",
        "Valid": "v > 0 || isnan(v)",
        "Description": "'OptimalityTolerance' option of the solver (NaN: the default of the solver)"
    },
    "QuadprogStepTolerance":{
        "Value": NaN,
        "Type": "double",
        "Description": "'StepTolerance' option @quadprog (NaN: the default of quadprog)"
    },
    "FminconStepTolerance":{
        "Value": NaN,
        "Type": "double",
        "Description": "'StepTolerance' option @fmincon (NaN: the default of fmincon)"
    },
    "FminconMaxFunctionEvaluations":{
        "Value": NaN,
        "Type": "double",
        "Description": "'MaxFunctionEvaluations' option @fmincon (NaN: the default of fmincon)"
    },
    "FminconUseParallel":{
        "Value": false,
        "Type": "logical",
        "Description": "'UseParallel' option @fmincon"
    },
    "WarmStart":{
        "Value": false,
        "Type": "logical",
        "Description": "Start 'AC OPF' from the last AC OPF solution of the network (false: flat start)"
    },
    "PlotFcn":{
        "Value": "none",
        "Type": "select",
        "options": [
            "none",
            "fval",
            "constrviolation",
            "fvalconstr",
            "firstorderopt",
            "stepsize",
            "funccount",
            "x"
        ],
        "Description": "Live display during the analysis (fmincon only, 'AC OPF'): the plot function optimplot<key> of fmincon, or 'none'. The figure after the analysis: result.plot_dispatch()"
    }
}
