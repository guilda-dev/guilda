{
    "Method":{
        "Value": "newton",
        "Type": "select",
        "options": [
            "newton",
            "gradient",
            "levenberg-marquardt",
            "fsolve",
            "dynamic"
        ],
        "Description": "Calculation method: 'newton', 'gradient', 'levenberg-marquardt', 'fsolve' (needs Optimization Toolbox) or 'dynamic' (virtual bus dynamics)"
    },
    "Tolerance":{
        "Value": 0,
        "Type": "double",
        "Description": "Convergence tolerance of the method (see SolverPF). 0 uses the method default"
    },
    "MaxIterations":{
        "Value": 0,
        "Type": "double",
        "Description": "Maximum number of iterations (see SolverPF). 0 uses the method default"
    },
    "Display":{
        "Value": "none",
        "Type": "select",
        "options": [
            "none",
            "iter",
            "iter-detailed",
            "final",
            "final-detailed"
        ],
        "Description": "Progress display ('iter': one line per iteration; 'Display' option @fsolve)"
    },
    "MaxFunEvals"  :{
        "Value": 0,
        "Type": "double",
        "Description": "'MaxFunEvals' option @fsolve (If NaN, use default)"
    }, 
    "UseParallel":{
        "Value": false,
        "Type": "logical",
        "Description": "'UseParallel' option @fsolve"
    },
    "PlotFcn":{
        "Value": "none",
        "Type": "select",
        "options":[
            "none",
            "optimplotx",
            "optimplotfunccount",
            "optimplotfval",
            "optimplotstepsize",
            "optimplotfirstorderopt"
        ],
        "Description": "'PlotFcn' option @fsolve"
    },
    "WhenFailed":{
        "Value": "WARN",
        "Type": "select",
        "options":[
            "WARN",
            "DISP",
            "ERROR",
            "NONE"
        ],
        "Description": "Behavior if the power flow calculation does not converge"
    }
}