{
  "_comment": [
    "Layout of the option forms of DrawerOptionDialog, by signature of functionSignatures.json (see the DrawerOptionDialog help).",
    "main: options shown right after the required inputs, in this order. groups: collapsible groups (closed), in this order.",
    "Options of a listed signature that no list names go to the group Advanced. A signature missing here uses _fallback.",
    "labels: an English label and/or a unit by input name, the word shown for NaN (nan) and a short hint beside the field (hint). visible: show the names only while one of the conditions of when holds",
    "(a condition: every input it names has one of the values; {\"not\": [...]} for none of them; numbers as text, e.g. \"NaN\").",
    "propertyDefaults: the class whose property defaults are the defaults of options without Default: (opt.?Class).",
    "pick: element kinds (Bus, Branch, Component, ...) for an input without choices that takes tags; it gets a Select... button."
  ],
  "_fallback": {
    "groups": [
      {"name": "Limits", "pattern": "^([PQVSI]|Varg)(min|max)$"},
      {"name": "OPF", "prefix": ["OPF"]},
      {"name": "Stability", "prefix": ["Stability"], "members": ["MinDampingRatio", "MaxRealPart"]},
      {"name": "Graph", "members": ["DX", "DY", "X", "Y", "Shape", "Path", "Offset", "FromOffset", "ToOffset", "Length", "MarkerSize", "Color", "Style"]},
      {"name": "Advanced", "members": ["Parent", "PlotFcn", "Progress", "Format", "WarmStart", "Export"]}
    ]
  },

  "Bus.add_component": {
    "main": ["P", "Q", "parameter"],
    "groups": [
      {"name": "Limits", "members": ["Pmin", "Pmax", "Qmin", "Qmax"]},
      {"name": "OPF", "members": ["OPFcost_HP", "OPFcost_fP", "OPFcost_HQ", "OPFcost_fQ", "OPFcost_c", "OPFinit_P0", "OPFinit_Q0", "OPFcost_startup", "OPFcost_shutdown"]},
      {"name": "Graph", "members": ["DX", "DY", "Shape", "Path", "Offset", "MarkerSize", "Color"]},
      {"name": "Advanced", "members": ["baseMVA"]}
    ],
    "labels": {
      "OPFcost_HP": {"label": "Cost P (quadratic)"}, "OPFcost_fP": {"label": "Cost P (linear)"},
      "OPFcost_HQ": {"label": "Cost Q (quadratic)"}, "OPFcost_fQ": {"label": "Cost Q (linear)"},
      "OPFcost_c": {"label": "Cost (constant)"},
      "OPFinit_P0": {"label": "Initial P"}, "OPFinit_Q0": {"label": "Initial Q"},
      "OPFcost_startup": {"label": "Startup cost"}, "OPFcost_shutdown": {"label": "Shutdown cost"}
    }
  },
  "Bus.replace_component": {
    "main": ["parameter", "Controllers"]
  },
  "Component.add_local_controller": {
    "main": ["parameter"]
  },
  "PowerNetwork.add_bus": {
    "main": ["V", "Varg", "Gshunt", "Bshunt", "FullTag"],
    "groups": [
      {"name": "Limits", "members": ["Vmin", "Vmax"]},
      {"name": "Graph", "members": ["X", "Y", "Shape", "Length", "MarkerSize", "Color"]},
      {"name": "Advanced", "members": ["Tag", "baseKV", "baseMVA"]}
    ],
    "labels": {"FullTag": {"label": "Tag"}, "Tag": {"label": "Tag prefix"}},
    "visible": [
      {"names": ["Length"], "when": [{"Shape": ["hbar", "vbar"]}]}
    ]
  },
  "PowerNetwork.add_branch": {
    "main": ["from_to", "R", "X", "C", "Tap", "Phase", "Circuit"],
    "groups": [
      {"name": "Limits", "members": ["Smax", "Imax", "Pmax", "Qmax", "Vargmax"]},
      {"name": "Graph", "members": ["Style", "Path", "FromOffset", "ToOffset"]}
    ],
    "labels": {"from_to": {"label": "From, to"}},
    "visible": [
      {"names": ["Tap", "Phase"], "when": [{"Key": {"not": ["pi", "T"]}}]}
    ]
  },
  "PowerNetwork.add_global_controller": {
    "main": ["parameter"],
    "pick": {"a_Unit": ["Component"]}
  },
  "PowerNetwork.add_scenario": {
    "main": ["Time", "Description"],
    "groups": [
      {"name": "Copy", "members": ["From", "Event"]}
    ]
  },

  "PowerNetwork.calculate_powerflow": {
    "main": ["Solver", "Tolerance", "MaxIteration", "Verbose"],
    "groups": [
      {"name": "Advanced", "members": ["WarmStart", "PlotFcn", "Progress", "Format"]}
    ]
  },
  "PowerNetwork.calculate_optimal_powerflow": {
    "main": ["Method", "Solver", "Tolerance", "MaxIteration", "Verbose"],
    "groups": [
      {"name": "Cost and constraints", "members": ["DefaultCost", "Cost", "Constraint", "ReferenceBus"]},
      {"name": "Stability", "members": ["MinDampingRatio", "MaxRealPart", "StabilityMaxIteration", "StabilityStep", "StabilityMargin", "StabilityBand"]},
      {"name": "Advanced", "members": ["WarmStart", "PlotFcn", "Progress", "Problem", "InitialPoint"]}
    ],
    "visible": [
      {"names": ["MinDampingRatio", "MaxRealPart"], "when": [{"Method": ["AC OPF"]}]},
      {"names": ["StabilityMaxIteration", "StabilityStep", "StabilityMargin", "StabilityBand"],
       "when": [{"Method": ["AC OPF"], "MinDampingRatio": {"not": ["NaN"]}}, {"Method": ["AC OPF"], "MaxRealPart": {"not": ["NaN"]}}]}
    ]
  },
  "PowerNetwork.calculate_continuation_powerflow": {
    "main": ["LoadBus", "StepSize", "MaxIteration", "Limits"],
    "pick": {"LoadBus": ["Bus"]},
    "groups": [
      {"name": "Advanced", "members": ["Tolerance", "ArcLength", "InitialLambda", "UseInternalState", "Verbose", "PlotFcn", "Progress", "Export"]}
    ]
  },
  "PowerNetwork.initialize": {
    "main": ["Method", "Solver", "Tolerance", "MaxIteration", "Verbose"],
    "groups": [
      {"name": "OPF", "members": ["DefaultCost", "Cost", "Constraint", "ReferenceBus", "Problem", "InitialPoint"]},
      {"name": "Stability", "members": ["MinDampingRatio", "MaxRealPart", "StabilityMaxIteration", "StabilityStep", "StabilityMargin", "StabilityBand"]},
      {"name": "Advanced", "members": ["WarmStart", "PlotFcn", "Progress"]}
    ],
    "visible": [
      {"names": ["DefaultCost", "Cost", "Constraint", "ReferenceBus", "Problem", "InitialPoint", "MinDampingRatio", "MaxRealPart"], "when": [{"Method": ["OPF"]}]},
      {"names": ["StabilityMaxIteration", "StabilityStep", "StabilityMargin", "StabilityBand"],
       "when": [{"Method": ["OPF"], "MinDampingRatio": {"not": ["NaN", ""]}}, {"Method": ["OPF"], "MaxRealPart": {"not": ["NaN", ""]}}]},
      {"names": ["PlotFcn"], "when": [{"Method": ["powerflow", "OPF"]}]},
      {"names": ["Progress"], "when": [{"Method": ["powerflow", "OPF", "FixedInput"]}]}
    ]
  },
  "PowerNetwork.simulate": {
    "main": ["Time", "Solver", "Tolerance", "MaxStep", "SampleTime"],
    "groups": [
      {"name": "Stop", "members": ["StopOnOutOfStep", "StopAngle", "TimeLimit"]},
      {"name": "Advanced", "members": ["AbsoluteTolerance", "InitialStep", "SeparateComplexParts", "Progress", "Verbose", "PlotFcn", "Format"]}
    ],
    "visible": [
      {"names": ["StopAngle"], "when": [{"StopOnOutOfStep": ["true"]}]}
    ]
  },
  "PowerSystemModel.get_sys": {
    "main": ["point", "Type", "Port"],
    "groups": [
      {"name": "Advanced", "members": ["Input", "Output", "PlotFcn", "Format"]}
    ],
    "visible": [
      {"names": ["Port"], "when": [{"Type": ["DAE"]}]}
    ]
  },

  "Scenario.add_fault": {"main": ["Status", "Point"], "labels": {"Point": {"nan": "bus", "hint": "bus: a bus fault · 0 to 1 along a branch"}}},
  "Scenario.add_trip": {"main": []},
  "Scenario.add_open_branch": {"main": ["Status"]},
  "Scenario.add_offset": {"main": ["time", "Tag"]},
  "Scenario.add_input": {"main": ["Method", "Tag"]},
  "EventFault.edit": {"main": ["Target", "Time", "Status", "Point"], "labels": {"Point": {"nan": "bus", "hint": "bus: a bus fault · 0 to 1 along a branch"}}},
  "EventTrip.edit": {"main": ["Unit", "Time"]},
  "EventOpenBranch.edit": {"main": ["Branch", "Time", "Status"]},
  "EventOffset.edit": {"main": ["Unit", "State", "Value", "Time", "Tag"]},
  "EventInput.edit": {"main": ["Unit", "Name", "Value", "Time", "Method", "Tag"]},

  "ResultPF.plot_voltage": {"main": ["Quantity", "Limit"], "groups": [{"name": "Advanced", "members": ["Parent"]}]},
  "ResultPF.plot_branch": {"main": ["Quantity"], "groups": [{"name": "Advanced", "members": ["Parent"]}]},
  "ResultPF.plot_convergence": {"main": ["Bus"], "groups": [{"name": "Advanced", "members": ["Parent"]}]},
  "ResultPF.plot_spring_model": {"main": ["Dimension"], "groups": [{"name": "Advanced", "members": ["Parent"]}]},
  "ResultPF.plot_single_line_diagram": {"main": [], "groups": [{"name": "Advanced", "members": ["Parent"]}]},
  "ResultODE.plot_spring_model": {"main": ["Dimension", "Trajectory"], "groups": [{"name": "Advanced", "members": ["Parent"]}]},
  "ResultODE.plot_trajectory": {"main": ["Quantity", "Bus"], "groups": [{"name": "Advanced", "members": ["Parent"]}]},
  "ResultODE.plot_pqv": {"main": ["Bus"], "groups": [{"name": "Advanced", "members": ["Parent"]}]},
  "ResultOPF.plot_dispatch": {"main": [], "groups": [{"name": "Advanced", "members": ["Parent"]}]},
  "ResultOPF.plot_iteration": {"main": [], "groups": [{"name": "Advanced", "members": ["Parent"]}]},
  "ResultCPF.plot_pvcurve": {"main": ["Bus"], "groups": [{"name": "Advanced", "members": ["Parent"]}]},
  "ResultCPF.plot_pqv": {"main": ["Bus"], "groups": [{"name": "Advanced", "members": ["Parent"]}]},
  "ResultCPF.plot_spring_model": {"main": ["Dimension", "PVCurve", "PVBus"], "labels": {"PVBus": {"hint": "empty: the buses of plot_pvcurve (LoadBus)"}}, "groups": [{"name": "Advanced", "members": ["Parent"]}]},
  "ResultCPF.plot_stability_index": {"main": ["TopBus", "PVCurve", "PVBus"], "labels": {"PVBus": {"hint": "empty: the buses of plot_pvcurve (LoadBus)"}}, "groups": [{"name": "Advanced", "members": ["Parent"]}]},
  "ResultCPF.plot_generator": {"main": ["Quantity", "Generator", "PVCurve", "PVBus"], "labels": {"PVBus": {"hint": "empty: the buses of plot_pvcurve (LoadBus)"}}, "groups": [{"name": "Advanced", "members": ["Parent"]}]},
  "ResultCPF.plot_branch": {"main": ["Quantity", "Branch", "PVCurve", "PVBus"], "labels": {"Branch": {"hint": "empty: every branch (loss: the total)"}, "PVBus": {"hint": "empty: the buses of plot_pvcurve (LoadBus)"}}, "groups": [{"name": "Advanced", "members": ["Parent"]}]},
  "ResultLIN.plot_eigenvalue": {"main": ["Type", "Tolerance"], "groups": [{"name": "Advanced", "members": ["Parent"]}]},
  "ResultLIN.plot_eigenvalue_path": {"main": ["Type", "Tolerance"], "groups": [{"name": "Advanced", "members": ["Parent"]}]},
  "ResultLIN.plot_matrix": {"main": ["Matrix", "Display", "Type"], "groups": [{"name": "Advanced", "members": ["Port", "Form", "Index", "Parent"]}]},
  "ResultLIN.plot_kernel": {"main": ["Kernel", "Label"], "groups": [{"name": "Advanced", "members": ["Index", "Parent"]}]},
  "ResultLIN.plot_participation": {"main": ["Type"], "groups": [{"name": "Advanced", "members": ["Index", "Parent"]}]},
  "ResultLIN.plot_eigenvector": {"main": ["Side", "Type"], "groups": [{"name": "Advanced", "members": ["Index", "Parent"]}]},
  "ResultLIN.plot_reduced_matrix": {"main": ["State", "Block"], "groups": [{"name": "Advanced", "members": ["Index", "Parent"]}],
    "pick": {"target": {"table": "feval(@(T) [table(string(T.Owner), string(T.Class), repmat(\"element\", height(T), 1), VariableNames=[\"Tag\", \"Class\", \"Kind\"]); table(unique(string(T.Class), \"stable\"), unique(string(T.Class), \"stable\"), repmat(\"class\", numel(unique(string(T.Class))), 1), VariableNames=[\"Tag\", \"Class\", \"Kind\"])], obj.sct_model.sct_sys.tab_owner)"}}},
  "ResultLIN.get_contribution": {"main": [],
    "pick": {"target": {"table": "feval(@(T) [table(string(T.Owner), string(T.Class), repmat(\"element\", height(T), 1), VariableNames=[\"Tag\", \"Class\", \"Kind\"]); table(unique(string(T.Class), \"stable\"), unique(string(T.Class), \"stable\"), repmat(\"class\", numel(unique(string(T.Class))), 1), VariableNames=[\"Tag\", \"Class\", \"Kind\"])], obj.sct_model.sct_sys.tab_owner)"}}},
  "ResultLIN.get_reduced_matrix": {"main": ["State", "Index", "Time"],
    "pick": {"target": {"table": "feval(@(T) [table(string(T.Owner), string(T.Class), repmat(\"element\", height(T), 1), VariableNames=[\"Tag\", \"Class\", \"Kind\"]); table(unique(string(T.Class), \"stable\"), unique(string(T.Class), \"stable\"), repmat(\"class\", numel(unique(string(T.Class))), 1), VariableNames=[\"Tag\", \"Class\", \"Kind\"])], obj.sct_model.sct_sys.tab_owner)"}}},
  "ResultLIN.plot_contribution": {"main": ["Quantity", "State"], "groups": [{"name": "Advanced", "members": ["Index", "Parent"]}]},
  "ResultPF.plot_diagram": {
    "propertyDefaults": "GraphNetDiagram",
    "main": ["Dimension", "Trajectory", "ColorMode", "BusColorMode", "BranchWidthMode", "MarkerSizeMode", "BusHeightMode", "LabelMode", "FlowMode"],
    "groups": [
      {"name": "Colors", "members": ["ColorLimits", "Colormap", "ColorbarLabel", "BusColor", "ComponentColor", "BranchColor", "LinkColor", "SelectionColor"]},
      {"name": "Labels", "members": ["LabelFontSize", "LabelFontWeight", "BusLabel", "ComponentLabel", "TitleFormat"]},
      {"name": "Sizes", "members": ["BranchWidthRange", "MarkerSizeRange", "LinkWidth", "BusMarkerSize", "ComponentMarkerSize", "BranchLineWidth", "GridSpacing"]},
      {"name": "Flow", "members": ["FlowAnimation", "FlowSpeed", "BranchDirection", "LinkDirection"]},
      {"name": "Data", "members": ["BusColorData", "ComponentColorData", "BranchColorData", "LinkColorData"]},
      {"name": "Advanced", "members": ["Parent", "ElementClickedFcn", "TimeChangedFcn"]}
    ]
  },
  "ResultCPF.plot_diagram": {
    "propertyDefaults": "GraphNetDiagram",
    "labels": {"PVBus": {"hint": "empty: the buses of plot_pvcurve (LoadBus)"}},
    "main": ["PVCurve", "PVBus", "Dimension", "ColorMode", "BusColorMode", "BranchWidthMode", "MarkerSizeMode", "BusHeightMode", "LabelMode", "FlowMode"],
    "groups": [
      {"name": "Colors", "members": ["ColorLimits", "Colormap", "ColorbarLabel", "BusColor", "ComponentColor", "BranchColor", "LinkColor", "SelectionColor"]},
      {"name": "Labels", "members": ["LabelFontSize", "LabelFontWeight", "BusLabel", "ComponentLabel", "TitleFormat"]},
      {"name": "Sizes", "members": ["BranchWidthRange", "MarkerSizeRange", "LinkWidth", "BusMarkerSize", "ComponentMarkerSize", "BranchLineWidth", "GridSpacing"]},
      {"name": "Flow", "members": ["FlowAnimation", "FlowSpeed", "BranchDirection", "LinkDirection"]},
      {"name": "Data", "members": ["BusColorData", "ComponentColorData", "BranchColorData", "LinkColorData"]},
      {"name": "Advanced", "members": ["Parent", "ElementClickedFcn", "TimeChangedFcn"]}
    ]
  },
  "ResultODE.plot_diagram": {"same": "ResultPF.plot_diagram"},
  "ResultOPF.plot_lmp": {"same": "ResultPF.plot_diagram"}
}
