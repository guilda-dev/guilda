function comp = replace_component(obj, str_tag, Type, parameter)
% Replace a component of the bus by a component of another type.
%
% The new component keeps the power-flow, operation, OPF and graph settings and the
% number of the replaced one. The replacement is logged as a "Topology" edit, so
% `net.initialize()` is needed before the dynamic analyses.
%
% <@Examples>
% ```matlab
% net.a_Bus{1}.replace_component("SG1B001", "gen-classical");
% ```
%
% See also Bus.add_component, Bus.remove_component

    arguments
        obj
        str_tag              (1,1) string   % Tag of the component to replace.
        Type                 (1,:) char {mustBeMember(Type,{___KEY_LIST___})}   % Component type key, e.g. "gen-park" or "load-power".
        parameter             = nan;   % Dynamic parameters (table or string); NaN uses the class defaults.
    end
    arguments (Output)
        comp   % New Component object.
    end

    str_tagComp = string(obj.a_Component);
    lv_rmcub = str_tagComp==str_tag;
    if ~any(lv_rmcub)
        error("No component with '"+str_tag+"' was found.")
    end

    comp_pre = obj.a_Component{lv_rmcub};
    tab_pre  = [comp_pre.para_powerflow.tab_parameter, ...
                comp_pre.para_operation.tab_parameter, ...
                comp_pre.para_graph.tab_parameter];
    opt      = table2struct(tab_pre);

    tab_opf  = comp_pre.para_OPF;
    opt.OPFinit_P0       = tab_opf.P0;
    opt.OPFinit_Q0       = tab_opf.Q0;
    opt.OPFcost_HP       = tab_opf.HP;
    opt.OPFcost_HQ       = tab_opf.HQ;
    opt.OPFcost_fP       = tab_opf.fP;
    opt.OPFcost_fQ       = tab_opf.fQ;
    opt.OPFcost_startup  = tab_opf.startup;
    opt.OPFcost_shutdown = tab_opf.shutdown;

    % keep the number of the replaced component: "<header><number><bus tag>"
    str_num   = regexp(extractBefore(comp_pre.str_tag, strlength(comp_pre.str_tag)-strlength(obj.str_tag)+1), "\d+$", "match", "once");
    str_index = string(str_num)+obj.str_tag;

    
    % get component function
    switch Type
___KEY_CASES___
    end
    comp = mkInst(str_index, parameter, opt);

    % register
    comp.set_bus(obj)        

    Iequilibrium = obj.a_Component{lv_rmcub}.c_Iequilibrium;
    Vequilibrium = obj.c_Vequilibrium;

    obj.a_Component{lv_rmcub} = comp;   
    
    % The constructor already built the f_* handles. The equilibrium is a
    % placeholder: the topology change below makes simulate/get_sys require
    % net.initialize() first.
    comp.set_equilibrium(Vequilibrium, Iequilibrium);
    obj.log_edit(obj.str_tag+" <<-replace--- "+str_tag+" -> "+comp.str_tag,"Topology")
    comp_pre.set_bus([])    % the replaced component no longer reads this bus
end